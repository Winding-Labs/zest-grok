#!/bin/sh
set -eu

DIR="$(cd "$(dirname "$0")" && pwd)"

# ── Platform detection ──────────────────────────────────────────────
OS=$(uname -s)
ARCH=$(uname -m)
# Apple Silicon under Rosetta (an x86_64 terminal or host) reports x86_64. Take arm64 there, as Claude Code's own
# installer does: otherwise a Rosetta shell caches the x64 runtime while the native agent's hooks look for the arm64
# one, find none and skip every session (Mac e2e, 2026-11-24). An arm64-only binary runs native from any parent.
if [ "${OS}-${ARCH}" = "Darwin-x86_64" ] && [ "$(/usr/sbin/sysctl -n sysctl.proc_translated 2>/dev/null)" = "1" ]; then
  ARCH=arm64
fi

case "${OS}-${ARCH}" in
  Darwin-arm64)    PLATFORM="darwin-arm64";  BIN_NAME="zest-grok-darwin-arm64" ;;
  Darwin-x86_64)   PLATFORM="darwin-x64";    BIN_NAME="zest-grok-darwin-x64" ;;
  Linux-x86_64)    PLATFORM="linux-x64";     BIN_NAME="zest-grok-linux-x64" ;;
  Linux-aarch64)   PLATFORM="linux-arm64";   BIN_NAME="zest-grok-linux-arm64" ;;
  MINGW*|MSYS*|CYGWIN*)
    # On Windows the .cmd launcher handles download natively.
    # Hand off so we don't try to gunzip a .zip asset.
    CMD="$DIR/zest-grok.cmd"
    if [ -f "$CMD" ]; then
      exec "$CMD" "$@"
    fi
    echo "Zest: zest-grok.cmd not found — reinstall plugin" >&2; exit 1 ;;
  *)
    echo "Zest: unsupported platform ${OS}-${ARCH}" >&2; exit 1 ;;
esac

# ── Escape hatch ────────────────────────────────────────────────────
if [ -n "${ZEST_BINARY_PATH:-}" ]; then
  exec "$ZEST_BINARY_PATH" "$@"
fi

# ── Read manifest (pinned format, one key per line) ─────────────────
MANIFEST="$DIR/manifest.json"
if [ ! -f "$MANIFEST" ]; then
  echo "Zest: manifest.json missing — reinstall plugin" >&2
  exit 1
fi

# manifest_value KEY [FILE] (default: this plugin's manifest)
manifest_value() {
  sed -n "s/^[[:space:]]*\"$1\":[[:space:]]*\"\{0,1\}\([^\",$]*\)\"\{0,1\},\{0,1\}$/\1/p" "${2:-$MANIFEST}" | head -1
}

# Top-level fields
VERSION=$(manifest_value "version")
REPO=$(manifest_value "repo")

# Per-platform fields: extract the block for our platform, then read keys
# platform_value KEY [FILE] (default: this plugin's manifest)
platform_value() {
  sed -n "/\"${PLATFORM}\":/,/}/p" "${2:-$MANIFEST}" | sed -n "s/^[[:space:]]*\"$1\":[[:space:]]*\"\{0,1\}\([^\",$]*\)\"\{0,1\},\{0,1\}$/\1/p" | head -1
}

ASSET_FILE=$(platform_value "file")
EXPECTED_SHA=$(platform_value "sha256")
COMPRESSED_SIZE=$(platform_value "compressed_size")

if [ -z "$VERSION" ] || [ -z "$ASSET_FILE" ] || [ -z "$EXPECTED_SHA" ]; then
  echo "Zest: cannot parse manifest.json for ${PLATFORM}" >&2
  exit 1
fi

# ── Integrity ───────────────────────────────────────────────────────
# Every binary is re-hashed right before it runs, not only after a download: a cached,
# fallback or sibling binary that does not match its manifest's sha256 never runs.
if command -v sha256sum >/dev/null 2>&1; then
  sha256_of() { sha256sum "$1" | cut -d' ' -f1; }
elif command -v shasum >/dev/null 2>&1; then
  sha256_of() { shasum -a 256 "$1" | cut -d' ' -f1; }
else
  echo "Zest: no sha256 tool available. Set ZEST_BINARY_PATH for manual install." >&2
  exit 1
fi

# matches_sha FILE EXPECTED: true only when both are there and the hashes agree.
matches_sha() {
  [ -n "$2" ] && [ -f "$1" ] && [ "$(sha256_of "$1")" = "$2" ]
}

# A verified binary keeps its manifest's hash beside it (<bin>.sha256), so it can still be
# checked once a plugin update makes it the fallback and its manifest is gone.
remember_sha() {
  [ "$(cat "$1.sha256" 2>/dev/null)" = "$2" ] || { printf '%s\n' "$2" > "$1.sha256"; } 2>/dev/null || true
}

# expected_sha VERSION BIN: the sha256 a cached binary of VERSION must have. Its
# remembered hash, else the manifest of that version in a sibling plugin folder.
expected_sha() {
  if [ -f "$2.sha256" ]; then
    cat "$2.sha256"
    return 0
  fi
  _m="$DIR/../../$1/bin/manifest.json"
  [ -f "$_m" ] && [ "$(manifest_value "version" "$_m")" = "$1" ] && platform_value "sha256" "$_m"
  return 0
}

# ── Cache check ─────────────────────────────────────────────────────
CACHE_BASE="${HOME}/.zest/bin/grok"
CACHE_DIR="${CACHE_BASE}/${VERSION}"
CACHED_BIN="${CACHE_DIR}/${BIN_NAME}"

# verify_cached: true when the pinned binary is cached and matches the manifest. A cached
# binary that does not match is removed, so the rest of the script downloads or falls back.
verify_cached() {
  [ -x "$CACHED_BIN" ] || return 1
  if matches_sha "$CACHED_BIN" "$EXPECTED_SHA"; then
    remember_sha "$CACHED_BIN" "$EXPECTED_SHA"
    return 0
  fi
  echo "Zest: cached runtime v${VERSION} failed its integrity check; removing it" >&2
  rm -f "$CACHED_BIN" "$CACHED_BIN.sha256"
  return 1
}

if verify_cached; then
  unset ZEST_PINNED_VERSION
  export ZEST_PLUGIN_ROOT="$(dirname "$DIR")"
  exec "$CACHED_BIN" "$@"
fi

# ── Semver comparison ──────────────────────────────────────────────
# Returns 0 (true) if $1 > $2 by numeric component comparison.
# Skips non-version directory names (anything with a non-digit/dot char).
ver_gt() {
  case "$1" in *[!0-9.]*) return 1 ;; esac
  case "$2" in *[!0-9.]*) return 1 ;; esac
  IFS=. read -r a1 a2 a3 <<EOF
$1
EOF
  IFS=. read -r b1 b2 b3 <<EOF
$2
EOF
  a1=${a1:-0}; a2=${a2:-0}; a3=${a3:-0}
  b1=${b1:-0}; b2=${b2:-0}; b3=${b3:-0}
  [ "$a1" -gt "$b1" ] 2>/dev/null && return 0
  [ "$a1" -lt "$b1" ] 2>/dev/null && return 1
  [ "$a2" -gt "$b2" ] 2>/dev/null && return 0
  [ "$a2" -lt "$b2" ] 2>/dev/null && return 1
  [ "$a3" -gt "$b3" ] 2>/dev/null && return 0
  return 1
}

# ── Download allowlist ──────────────────────────────────────────────
# Only interactive commands may trigger a download. Non-interactive
# verbs (hook, daemon) fall back to the newest OTHER cached version so
# capture continues on N-1 after a plugin update until the user runs
# an interactive command that fetches the pinned version.
VERB="${1:-}"

# Find the newest cached binary that is NOT the pinned version.
find_fallback_binary() {
  BEST_VER=""
  BEST_PATH=""
  for dpath in "${CACHE_BASE}"/*/; do
    [ -d "$dpath" ] || continue
    d=$(basename "$dpath")
    [ "$d" = "$VERSION" ] && continue
    case "$d" in *[!0-9.]*) continue ;; esac
    CANDIDATE="${dpath}${BIN_NAME}"
    if [ -x "$CANDIDATE" ]; then
      if [ -z "$BEST_VER" ] || ver_gt "$d" "$BEST_VER"; then
        matches_sha "$CANDIDATE" "$(expected_sha "$d" "$CANDIDATE")" || continue
        BEST_VER="$d"
        BEST_PATH="$CANDIDATE"
      fi
    fi
  done
  [ -n "$BEST_PATH" ] && echo "$BEST_PATH" && return 0
  return 1
}

# Try cached or sibling binary as degraded fallback, exec if found, return 1 if none.
# Exports ZEST_PINNED_VERSION so the running binary knows it is NOT the pinned version.
try_fallback_exec() {
  FALLBACK_BIN=$(find_fallback_binary) && {
    export ZEST_PINNED_VERSION="$VERSION"
    export ZEST_PLUGIN_ROOT="$(dirname "$DIR")"
    exec "$FALLBACK_BIN" "$@"
  }
  # Sibling-version fallback: one-release bridge for hosts transitioning
  # from tip-binary to release-binary. Scans sibling plugin-version dirs
  # for a binary with exact name $BIN_NAME that matches the sha256 in the
  # manifest.json beside it (none or no match: skipped). Claude Code retains ~3 recent
  # plugin versions and prunes older ones within a day; sibling fallback
  # therefore bridges ~3 releases. Remove after all clients ship release-binary.
  # Use find (not an unquoted glob) so plugin cache paths with spaces survive.
  SIBLING_GLOB=""
  if [ -n "$SIBLING_GLOB" ]; then
    BEST_SIBLING=""
    BEST_SIBLING_VER=""
    cache_root=$(CDPATH= cd "$DIR/../.." && pwd) || cache_root=""
    if [ -n "$cache_root" ]; then
      while IFS= read -r sibling; do
        [ -x "$sibling" ] || continue
        sver=$(basename "$(dirname "$(dirname "$sibling")")")
        case "$sver" in *[!0-9.]*) continue ;; esac
        if [ -z "$BEST_SIBLING_VER" ] || ver_gt "$sver" "$BEST_SIBLING_VER"; then
          sdir=$(dirname "$sibling")
          [ -f "$sdir/manifest.json" ] || continue
          matches_sha "$sibling" "$(platform_value "sha256" "$sdir/manifest.json")" || continue
          BEST_SIBLING_VER="$sver"
          BEST_SIBLING="$sibling"
        fi
      done <<EOF
$(find "$cache_root" -maxdepth 3 -type f -name "$BIN_NAME" 2>/dev/null)
EOF
    fi
    if [ -n "$BEST_SIBLING" ]; then
      export ZEST_PINNED_VERSION="$VERSION"
      export ZEST_PLUGIN_ROOT="$(dirname "$DIR")"
      exec "$BEST_SIBLING" "$@"
    fi
  fi
  return 1
}

# No runtime at all for a hook: the installer's one fetch failed (offline, a proxy, its 180 s
# timeout), or the plugin was installed by hand and no /zest: command ever ran. A hook can't wait for
# a ~30 MB download, so start it in the background, one at a time (the download lock), and the next
# hook runs on it. `set -m` gives it its own process group, so it outlives the hook. Until 2026-11-24
# such a hook only said binary_not_cached, to a log nobody reads: every session on that computer
# was lost, and nothing reached the server to say so.
fetch_in_background() {
  [ "$VERB" = "hook" ] || return 0
  [ -d "${CACHE_DIR}/.download-lock" ] && return 0
  (set -m; "$DIR/zest-grok" command status </dev/null >/dev/null 2>&1 &) 2>/dev/null || true
}

case "$VERB" in
  command) ;; # proceed to download
  *)
    try_fallback_exec "$@" || {
      fetch_in_background
      echo '{"status":"binary_not_cached","version":"'"$VERSION"'"}' >&2
      case "$VERB" in daemon) exit 1 ;; *) exit 0 ;; esac
    }
    ;;
esac

# ── Download with locking ───────────────────────────────────────────
LOCK_DIR="${CACHE_DIR}/.download-lock"
LOCK_HELD=false

cleanup() {
  rm -f "${CACHE_DIR}/.download.$$" "${CACHE_DIR}/.bin.$$" 2>/dev/null || true
  rm -rf "${CACHE_DIR}/.extract.$$" 2>/dev/null || true
  if [ "$LOCK_HELD" = true ] && [ -f "$LOCK_DIR/pid" ]; then
    LOCK_PID=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
    if [ "$LOCK_PID" = "$$" ]; then
      rm -rf "$LOCK_DIR" 2>/dev/null || true
    fi
  fi
}
trap cleanup EXIT INT TERM

# try_fallback_exec ends in exec, which replaces this process and skips the
# EXIT trap — the lock dir would survive holding a PID that is still alive
# (exec keeps the PID), so the stale-lock reaper would never reclaim it.
# Release explicitly before handing off.
release_before_fallback() {
  cleanup
  trap - EXIT INT TERM
}

mkdir -p "$CACHE_DIR"

# Acquire lock (mkdir is atomic)
LOCK_TRIES=0
MAX_LOCK_WAIT=120
while ! mkdir "$LOCK_DIR" 2>/dev/null; do
  LOCK_TRIES=$((LOCK_TRIES + 1))
  if [ "$LOCK_TRIES" -ge "$MAX_LOCK_WAIT" ]; then
    echo "Zest: timed out waiting for download lock" >&2
    try_fallback_exec "$@" || exit 1
  fi
  # Check if holding PID is alive
  if [ -f "$LOCK_DIR/pid" ]; then
    LOCK_PID=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
    if [ -n "$LOCK_PID" ] && ! kill -0 "$LOCK_PID" 2>/dev/null; then
      rm -rf "$LOCK_DIR" 2>/dev/null || true
      continue
    fi
  fi
  sleep 1
done
echo $$ > "$LOCK_DIR/pid"
LOCK_HELD=true

# Re-check cache (another process may have finished)
if verify_cached; then
  rm -rf "$LOCK_DIR" 2>/dev/null || true
  LOCK_HELD=false
  trap - EXIT INT TERM
  unset ZEST_PINNED_VERSION
  export ZEST_PLUGIN_ROOT="$(dirname "$DIR")"
  exec "$CACHED_BIN" "$@"
fi

# ── Download ────────────────────────────────────────────────────────
# ZEST_DOWNLOAD_BASE_URL: override for air-gapped or locked-down environments.
# Point it at any HTTPS server that hosts the release assets at the root, e.g.
#   ZEST_DOWNLOAD_BASE_URL=https://internal-mirror:8443
# downloads from https://internal-mirror:8443/zest-grok-darwin-arm64.gz
# Plain http is refused: the binary and its sha256 check would both be open to the network.
if [ -n "${ZEST_DOWNLOAD_BASE_URL:-}" ]; then
  case "$ZEST_DOWNLOAD_BASE_URL" in
    https://*) ;;
    *)
      echo "Zest: ZEST_DOWNLOAD_BASE_URL must start with https://" >&2
      release_before_fallback
      try_fallback_exec "$@" || exit 1
      ;;
  esac
  URL="${ZEST_DOWNLOAD_BASE_URL}/${ASSET_FILE}"
else
  URL="https://github.com/${REPO}/releases/download/v${VERSION}/${ASSET_FILE}"
fi
DOWNLOAD_MB=""
if [ -n "$COMPRESSED_SIZE" ]; then
  DOWNLOAD_MB=$(( COMPRESSED_SIZE / 1048576 ))
  [ "$DOWNLOAD_MB" -lt 1 ] && DOWNLOAD_MB=1
fi
echo "Zest: downloading runtime v${VERSION} (${DOWNLOAD_MB:-?} MB, one time)"

TEMP_DL="${CACHE_DIR}/.download.$$"
# --proto =https: no redirect may downgrade the download to http.
if ! curl -fsSL --proto '=https' --retry 2 --retry-delay 2 --connect-timeout 10 --max-time 300 -o "$TEMP_DL" "$URL"; then
  echo "Zest: download failed. Check network or set ZEST_BINARY_PATH for manual install." >&2
  release_before_fallback
  try_fallback_exec "$@" || exit 1
fi

# ── Decompress ──────────────────────────────────────────────────────
TEMP_BIN="${CACHE_DIR}/.bin.$$"
if ! gunzip -c "$TEMP_DL" > "$TEMP_BIN"; then
  echo "Zest: decompression failed" >&2
  release_before_fallback
  try_fallback_exec "$@" || exit 1
fi
rm -f "$TEMP_DL"

# ── Verify SHA256 ───────────────────────────────────────────────────
ACTUAL_SHA=$(sha256_of "$TEMP_BIN")
if [ "$ACTUAL_SHA" != "$EXPECTED_SHA" ]; then
  echo "Zest: integrity check failed" >&2
  echo "  expected: $EXPECTED_SHA" >&2
  echo "  actual:   $ACTUAL_SHA" >&2
  rm -f "$TEMP_BIN"
  release_before_fallback
  try_fallback_exec "$@" || exit 1
fi

# ── Atomic rename ───────────────────────────────────────────────────
# The exec below runs this same file, hashed just above.
mv "$TEMP_BIN" "$CACHED_BIN"
chmod +x "$CACHED_BIN"
remember_sha "$CACHED_BIN" "$EXPECTED_SHA"

# ── GC (best-effort) ───────────────────────────────────────────────
# Keep the pinned version (just downloaded) and the newest other version
# (fallback for hooks/daemon after a future update). Remove the rest.
(
  NEWEST_VER=""
  NEWEST_PATH=""
  for dpath in "${CACHE_BASE}"/*/; do
    [ -d "$dpath" ] || continue
    d=$(basename "$dpath")
    [ "$d" = "$VERSION" ] && continue
    case "$d" in *[!0-9.]*) continue ;; esac
    if [ -z "$NEWEST_VER" ] || ver_gt "$d" "$NEWEST_VER"; then
      NEWEST_VER="$d"
      NEWEST_PATH="$dpath"
    fi
  done
  for dpath in "${CACHE_BASE}"/*/; do
    [ -d "$dpath" ] || continue
    d=$(basename "$dpath")
    [ "$d" = "$VERSION" ] && continue
    [ "$dpath" = "$NEWEST_PATH" ] && continue
    rm -rf "${dpath}" 2>/dev/null || true
  done
) 2>/dev/null || true

# ── Release lock & exec ────────────────────────────────────────────
rm -rf "$LOCK_DIR" 2>/dev/null || true
LOCK_HELD=false
trap - EXIT INT TERM
unset ZEST_PINNED_VERSION
export ZEST_PLUGIN_ROOT="$(dirname "$DIR")"
exec "$CACHED_BIN" "$@"
